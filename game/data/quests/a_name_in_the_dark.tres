[resource]
script = ExtResource("1_script")
id = &"a_name_in_the_dark"
title = "A Name in the Dark"
offer_text = "The acolytes answer to someone. Cultists like these carry their orders sealed, and burn them before they let them be taken.

Bring me one of their missives unbroken, {name}, and take it straight to Warden Thalos. The Watch must hear this first."
progress_text = "Ivren sent word you'd bring something. What did you find?"
complete_text = "\"The Vale has fed the Core enough. Withdraw the hands to the Crystal Canyons. The seals must break before the solstice.\" Signed with a dark sun.

The Veiled Core. I thought it a fable. If the Eclipse Hand means to wake it, Silverrun was only the beginning.

You have done more for this Vale than any warden in years, {name}. Take this. It was cut from our own Wardstone. When you leave the Vale, and you will, it goes with you."
kind = 1
enemy_id = &"eclipse_acolyte"
objective = "Sealed Eclipse Missive"
required = 1
drop_chance = 0.4
xp_reward = 800
reward_item = ExtResource("4_reward")
reputation_factions = Array[ExtResource("2_faction")]([ExtResource("10_watch"), ExtResource("11_concord")])
reputation_amounts = PackedInt32Array(300, 150)
min_level = 5
requires = ExtResource("5_requires")
turn_in_npc = &"thalos"
