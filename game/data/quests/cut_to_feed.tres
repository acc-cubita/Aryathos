[resource]
script = ExtResource("1_script")
id = &"cut_to_feed"
title = "Cut to Feed"
offer_text = "The scavengers do not sell every shard they cut. Most of it goes into crates at their dig site in the south, packed in salt to keep the light from bleeding out. A stockpile like that could call a storm on its own.

Go to the Gloomshard Dig Site and smash four of their caches. Do not touch the shards with your bare hands."
progress_text = "The caches, {name}. Every crate you leave whole is a storm waiting."
complete_text = "Four caches broken, and the storm-light over the dig site already dims.

Someone is paying for all this cutting, {name}. Someone patient. Wear this. It will hum when the storms are near."
kind = 5
object_id = &"gloomshard_cache"
objective = "Gloomshard Cache smashed"
required = 4
xp_reward = 400
reward_item = ExtResource("4_reward")
reputation_factions = Array[ExtResource("2_faction")]([ExtResource("10_watch")])
reputation_amounts = PackedInt32Array(200)
min_level = 3
requires = ExtResource("5_requires")
