[resource]
script = ExtResource("1_script")
id = &"wolves_at_the_wardstone"
title = "Wolves at the Wardstone"
offer_text = "The crystal storms have twisted the wolves of Silverrun Vale. Shards grow from their backs, and the light inside drives them mad. Every night they prowl closer to the Wardstone.

Thin the packs to the north and west, {name}. Slay six Shardfang Wolves and return to me."
progress_text = "The howling has not stopped. Have you dealt with the wolves?"
complete_text = "Well done, {name}. The Wardstone already burns brighter.

But the wolves are only a symptom. Something is feeding the storms."
enemy_id = &"shardfang_wolf"
objective = "Shardfang Wolf slain"
required = 6
xp_reward = 250
reward_item = ExtResource("9_reward")
reputation_factions = Array[ExtResource("42_faction")]([ExtResource("40_watch")])
reputation_amounts = PackedInt32Array(150)
