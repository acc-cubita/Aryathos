[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://data/quest_data.gd" id="1_script"]
[ext_resource type="Script" path="res://data/faction_data.gd" id="2_faction"]
[ext_resource type="Resource" path="res://data/factions/azure_concord.tres" id="10_concord"]
[ext_resource type="Resource" path="res://data/items/dustwalker_boots.tres" id="4_reward"]

[resource]
script = ExtResource("1_script")
id = &"dust_on_the_wind"
title = "Dust on the Wind"
offer_text = "First things first. The dust coyotes have grown bold since the crystal started singing in the walls. They run in packs down the east canyon and out onto the Dustwind Mesas, and this month they've taken two mules and most of a carter's leg.

Thin the packs, {name}. Eight of them. The canyon will be quieter, and so will my carters."
progress_text = "I still hear them howling at night. That's not eight."
complete_text = "Eight fewer, and the carters already louder for it.

Here, Hilde's work: boots for canyon stone. The dust gets into everything else."
kind = 0
enemy_id = &"dust_coyote"
objective = "Dust Coyote slain"
required = 8
xp_reward = 650
reward_item = ExtResource("4_reward")
reputation_factions = Array[ExtResource("2_faction")]([ExtResource("10_concord")])
reputation_amounts = PackedInt32Array(250)
min_level = 5
