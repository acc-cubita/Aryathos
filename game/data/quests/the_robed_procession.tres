[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://data/quest_data.gd" id="1_script"]
[ext_resource type="Script" path="res://data/faction_data.gd" id="2_faction"]
[ext_resource type="Resource" path="res://data/factions/azure_concord.tres" id="10_concord"]
[ext_resource type="Resource" path="res://data/items/hammerfall_pauldrons.tres" id="4_reward"]
