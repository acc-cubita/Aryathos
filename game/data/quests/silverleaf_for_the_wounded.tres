[resource]
script = ExtResource("1_script")
id = &"silverleaf_for_the_wounded"
title = "Silverleaf for the Wounded"
offer_text = "Wolves bite, storms burn, and the wardens come back to me bleeding. Silverleaf closes wounds, if it's fresh.

If you haven't learned the old ways yet, I'll teach you Herbalism. Then bring me five Silverleaf from the meadows around the post. You'll know it by its pale, silver-edged leaves."
progress_text = "Silverleaf, {name}. Pale leaves, silver edges."
complete_text = "Fresh and whole. You have gentle hands for a Runeknight.

Here, keep one of my draughts. You'll need it before the wardens do."
kind = 3
item = ExtResource("3_item")
objective = "Silverleaf gathered"
required = 5
xp_reward = 200
reward_item = ExtResource("4_reward")
reputation_factions = Array[ExtResource("2_faction")]([ExtResource("10_watch")])
reputation_amounts = PackedInt32Array(100)
min_level = 1
