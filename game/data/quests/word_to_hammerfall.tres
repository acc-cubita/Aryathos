[resource]
script = ExtResource("1_script")
id = &"word_to_hammerfall"
title = "Word to Hammerfall"
offer_text = "The missive names the Crystal Canyons, {name}, and the canyons are not the Watch's to guard. The Orebound hold them for the Concord, from Hammerfall Hold beyond the eastern pass.

Thane Durgan must hear what we found: the seals, the solstice, the dark sun. Take the road east through the pass and put these words in his hands yourself."
progress_text = "A warden's seal on that letter. Thalos doesn't write unless the sky is falling. What does he say?"
complete_text = "Seals. In my canyons.

So that's who has been walking Duskreach Gorge by night with their lanterns shuttered. The old Orebound tales put a seal at the gorge's end, a door of stone no pick has ever marked. We called it the First Seal and thought it a story for children.

You'll stay a while, {name}. Hammerfall has work for anyone who can swing steel."
kind = 6
objective = "Speak with Thane Durgan in Hammerfall Hold"
required = 0
xp_reward = 350
reputation_factions = Array[ExtResource("2_faction")]([ExtResource("10_watch"), ExtResource("10_concord")])
reputation_amounts = PackedInt32Array(75, 150)
min_level = 4
requires = ExtResource("5_requires")
turn_in_npc = &"thane_durgan"
