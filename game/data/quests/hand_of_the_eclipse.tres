[resource]
script = ExtResource("1_script")
id = &"hand_of_the_eclipse"
title = "Hand of the Eclipse"
offer_text = "Where there is a sigil, there are hands to tend it. Since Grimjaw fell, the wardens have seen robed figures on both sides of the den, chanting where the crystal light pools.

They are acolytes of the Eclipse Hand, and their bolts swallow light. Strike first and strike hard. Six of them, {name}, and the sigil goes hungry."
progress_text = "The acolytes still chant by the den. I can feel it in the Wardstone."
complete_text = "Six fewer voices feeding the dark.

Take this mantle. It was woven at the Spire to turn aside exactly what they throw."
kind = 0
enemy_id = &"eclipse_acolyte"
objective = "Eclipse Hand Acolyte slain"
required = 6
xp_reward = 600
reward_item = ExtResource("4_reward")
reputation_factions = Array[ExtResource("2_faction")]([ExtResource("10_watch")])
reputation_amounts = PackedInt32Array(250)
min_level = 4
requires = ExtResource("5_requires")
