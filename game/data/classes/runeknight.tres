[resource]
script = ExtResource("1_script")
id = &"runeknight"
display_name = "Runeknight"
description = "A rune-axe warrior who binds Aether into runes: the axe up close, shards and storm-light from afar, crystal to mend wounds."
sort_order = 0
abilities = Array[ExtResource("1_ability")]([ExtResource("2"), ExtResource("3"), ExtResource("4"), ExtResource("5")])
talent_trees = Array[String](["Aether", "Storm", "Warding"])
talents = Array[ExtResource("1_talent")]([ExtResource("6"), ExtResource("7"), ExtResource("8"), ExtResource("9"), ExtResource("10"), ExtResource("11"), ExtResource("12"), ExtResource("13"), ExtResource("14"), ExtResource("15"), ExtResource("16"), ExtResource("17"), ExtResource("18")])
starting_weapon = ExtResource("19")
glow_color = Color(0.3, 0.7, 1, 1)
base_health = 140
health_per_level = 25
base_mana = 120
mana_per_level = 20
